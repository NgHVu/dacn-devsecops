pipeline {
    agent any 
    
    environment {
        // --- THÔNG TIN ĐÃ KHỚP VỚI REPO CỦA BẠN ---
        SERVICE_NAME        = 'orders' 
        AWS_REGION          = 'ap-southeast-1'
        AWS_ACCOUNT_ID      = '257394468168'
        ECR_REGISTRY        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_URI           = "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}"
        SCAN_CACHE_DIR      = "${WORKSPACE}/.trivy-cache"
        
        // --- THÔNG TIN GITOPS CHÍNH XÁC ---
        GITOPS_REPO_URL     = "github.com/NgHVu/dacn-config.git" 
        GITOPS_CRED_ID      = "github-pat" // Tên ID bạn cung cấp từ ảnh Jenkins
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
        timestamps()
        ansiColor('xterm')
    }

    stages {
        stage('1. Initialize') {
            steps {
                script {
                    env.COMMIT_HASH = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    // Nếu là branch main thì dùng hash, branch khác thì thêm tên branch vào tag
                    env.IMAGE_TAG = (env.BRANCH_NAME == 'main') ? env.COMMIT_HASH : "${env.BRANCH_NAME}-${env.COMMIT_HASH}"
                    
                    sh 'chmod +x scripts/*.sh'
                    echo "--> STARTING CI FOR BRANCH: ${env.BRANCH_NAME} | TAG: ${env.IMAGE_TAG}"
                }
                // Login vào ECR của AWS
                sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
            }
        }

        stage('2. Parallel Analysis') {
            parallel {
                stage('Code Quality (SonarQube)') {
                    agent {
                        docker {
                            image 'maven:3.9-eclipse-temurin-21'
                            args '--network host -v $HOME/.m2:/root/.m2 -u 0:0'
                            reuseNode true
                        }
                    }
                    steps {
                        withSonarQubeEnv('sonarqube-local') {
                            sh "./scripts/analyze-backend.sh ${SERVICE_NAME}"
                        }
                    }
                }

                stage('Security Scan (Trivy)') {
                    steps {
                        sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} HIGH,CRITICAL"
                    }
                }
            }
        }

        stage('3. Quality Gate') {
            steps {
                // Đợi SonarQube phản hồi kết quả
                timeout(time: 5, unit: 'MINUTES') { 
                    waitForQualityGate abortPipeline: true 
                }
            }
        }

        stage('4. Build & Push Docker') {
            when { branch 'main' }
            steps {
                // Build và đẩy image lên ECR
                sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${IMAGE_URI} ${env.IMAGE_TAG}"
            }
        }

        stage('5. Update GitOps (ArgoCD)') {
    when { branch 'main' }
    steps {
        script {
            echo "--> 🔄 Updating dacn-config Manifest with new image tag: ${env.IMAGE_TAG}"
            withCredentials([usernamePassword(credentialsId: "${GITOPS_CRED_ID}", passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
                sh """
                    # 1. Xóa sạch và clone lại
                    rm -rf tmp-gitops
                    git clone https://${GIT_USER}:${GIT_PASS}@${GITOPS_REPO_URL} tmp-gitops
                    
                    # 2. Kiểm tra cấu trúc thư mục thực tế (Log ra để debug)
                    echo "--- THƯ MỤC TRONG REPO ---"
                    ls -R tmp-gitops
                    
                    # 3. Di chuyển vào thư mục chứa file values
                    # LƯU Ý: Nếu repo của bạn không có folder environments/dev, hãy sửa đường dẫn này
                    cd tmp-gitops/environments/dev/ || cd tmp-gitops/
                    
                    # 4. Cập nhật tag image
                    sed -i 's/tag: .*/tag: ${env.IMAGE_TAG}/g' ${SERVICE_NAME}-values.yaml
                    
                    # 5. Commit và Push
                    git config user.email "nhoangvu2306@gmail.com"
                    git config user.name "NgHVu Jenkins Bot"
                    git add ${SERVICE_NAME}-values.yaml
                    git commit -m "Update ${SERVICE_NAME} image tag to ${env.IMAGE_TAG} [skip ci]"
                    git push origin HEAD:main
                """
            }
        }
    }
}

    post {
        always {
            echo '-->Cleaning up temporary data...'
            sh "docker rmi ${IMAGE_URI}:${env.IMAGE_TAG} || true"
            sh "rm -rf tmp-gitops"
        }
        success {
            echo "Pipeline completed successfully! ArgoCD will now sync the new version."
        }
    }
}