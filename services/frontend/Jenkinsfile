pipeline {
    agent any 
    
    environment {
        SERVICE_NAME        = 'frontend' 
        AWS_REGION          = 'ap-southeast-1'
        AWS_ACCOUNT_ID      = '257394468168'
        ECR_REGISTRY        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_URI           = "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}"
        SCAN_CACHE_DIR      = "/var/jenkins_home/caches/trivy"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
        timestamps()
        ansiColor('xterm')
    }

    stages {
        stage('1. Initialize') {
            steps {
                script {
                    // Lấy commit hash ngắn
                    env.COMMIT_HASH = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    // Tạo Tag: Nếu là main thì dùng commit hash, nếu branch khác thì thêm tên branch
                    if (env.BRANCH_NAME == 'main') {
                        env.IMAGE_TAG = env.COMMIT_HASH
                    } else {
                        env.IMAGE_TAG = "${env.BRANCH_NAME}-${env.COMMIT_HASH}"
                    }
                    
                    sh 'chmod +x scripts/*.sh'
                    echo "-->STARTING CI FOR BRANCH: ${env.BRANCH_NAME} | TAG: ${env.IMAGE_TAG}"
                }
                
                // Login ECR (Sử dụng IAM Role của EC2)
                sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
            }
        }

        stage('2. Parallel Analysis') {
            parallel {
                stage('Code Quality (SonarQube)') {
                    agent {
                        docker {
                            image 'node:20-bookworm'
                            args '-v $HOME/.m2:/root/.m2 -u 0:0'
                            reuseNode true
                        }
                    }
                    steps {
                        withSonarQubeEnv('sonarqube-local') {
                            sh "./scripts/analyze-frontend.sh"
                        }
                    }
                }

                stage('Security Scan (Trivy)') {
                    steps {
                        sh "./scripts/security-scan.sh services/${SERVICE_NAME} ${SCAN_CACHE_DIR} HIGH,CRITICAL"
                    }
                }
            }
        }

        stage('3. Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') { 
                    waitForQualityGate abortPipeline: true 
                }
            }
        }

        stage('4. Build & Push Docker') {
            // TIÊU CHUẨN PRO: Chỉ push lên ECR nếu là branch main
            when {
                branch 'main'
            }
            steps {
                sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${IMAGE_URI} ${env.IMAGE_TAG}"
            }
        }
    }

    post {
        always {
            echo '--> 🧹 Cleaning up...'
            sh "docker rmi ${IMAGE_URI}:${env.IMAGE_TAG} || true"
            sh "docker rmi ${IMAGE_URI}:latest || true"
        }
        failure {
            echo "Pipeline Failed on branch ${env.BRANCH_NAME}!"
        }
    }
}