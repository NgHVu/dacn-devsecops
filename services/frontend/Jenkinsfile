pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
    }

    environment {
        // [CẤU HÌNH RIÊNG CHO FRONTEND]
        IMAGE_NAME      = 'frontend'
        TRIVY_EXIT_CODE = '1'
        TRIVY_SEVERITY  = 'HIGH,CRITICAL'
        DOCKER_BUILDKIT = '1'
        TRIVY_CACHE_DIR = "/var/jenkins_home/caches/trivy"
    }

    stages {
        stage('1. Checkout SCM & Compute Tag') {
            steps {
                echo '--> Lấy mã nguồn từ Git và tính toán Image Tag...'
                sh 'git clean -fdx'
                checkout scm
                script {
                    env.IMAGE_TAG = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    if (!env.IMAGE_TAG) {
                        env.IMAGE_TAG = "dev-${env.BUILD_NUMBER}"
                    }
                    echo "--> IMAGE_TAG = ${env.IMAGE_TAG}"
                }
                // Đảm bảo thư mục cache tồn tại trước khi sử dụng
                sh "mkdir -p ${TRIVY_CACHE_DIR}"
            }
        }
        
        stage('1.5. Login to Registries') {
            steps {
                withCredentials([string(credentialsId: 'github-pat', variable: 'GITHUB_TOKEN')]) {
                    echo '--> Đăng nhập vào GitHub Container Registry...'
                    // Lưu ý: Tên user viết thường để tránh lỗi docker login
                    sh 'echo $GITHUB_TOKEN | docker login ghcr.io -u nghvu --password-stdin'
                }
            }
        }

        stage('1.6. Warm-up Caches') {
            agent {
                docker {
                    image 'ghcr.io/aquasecurity/trivy:0.49.1'
                    args "--entrypoint='' -v ${TRIVY_CACHE_DIR}:/root/.cache/trivy -u 0:0 --network dacn-ci_ci"
                    reuseNode true
                }
            }
            steps {
                echo '--> Đang cập nhật cơ sở dữ liệu Trivy (lần đầu có thể chậm)...'
                sh "trivy image --download-db-only --cache-dir /root/.cache/trivy --timeout 30m"
            }
        }

        stage('2. Build & Analyze (SonarQube)') {
            agent {
                docker {
                    // Sử dụng Node.js trên nền Debian (bookworm) để hỗ trợ cài Java cho SonarScanner
                    image 'node:20-bookworm-slim'
                    // Mount cache npm để tăng tốc độ cài package
                    args '-v $HOME/.npm:/root/.npm -u 0:0 --network dacn-ci_ci'
                    reuseNode true
                }
            }
            steps {
                dir('services/frontend') {
                    script {
                        echo '--> Cài đặt JRE (Bắt buộc cho SonarScanner)...'
                        sh 'apt-get update && apt-get install -y default-jre'

                        echo '--> Cài đặt thư viện Frontend...'
                        sh 'npm ci'

                        echo '--> Phân tích mã nguồn với SonarQube...'
                        withSonarQubeEnv('sonarqube-local') {
                            // Sử dụng npx để không phụ thuộc tool cài sẵn trên Jenkins
                            sh """
                                npx sonarqube-scanner \
                                -Dsonar.projectKey=frontend-service \
                                -Dsonar.sources=. \
                                -Dsonar.exclusions=**/.next/**,**/node_modules/**,**/out/** \
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                                -Dsonar.host.url=http://sonarqube:9000 \
                                -Dsonar.login=$SONAR_AUTH_TOKEN
                            """
                        }
                    }
                }
            }
        }
        
        stage('3. Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('4. Trivy FS Scan (SCA)') {
            steps {
                dir('services/frontend') {
                    echo '--> Quét thư viện với Trivy (Filesystem)...'
                    // Thêm .trivyignore nếu cần bỏ qua các lỗi đã biết
                    sh "trivy fs --cache-dir ${TRIVY_CACHE_DIR} --timeout 30m --ignore-unfixed --no-progress --severity ${TRIVY_SEVERITY} --exit-code ${TRIVY_EXIT_CODE} --ignorefile .trivyignore ."
                }
            }
        }

        stage('5. Build Docker Image') {
            steps {
                dir('services/frontend') {
                    echo '--> Building Docker image...'
                    script {
                        // Thêm --no-cache nếu muốn ép build lại từ đầu để nhận diện package-lock.json mới
                        sh "docker build --no-cache -t ${env.IMAGE_NAME}:${env.IMAGE_TAG} ."
                    }
                }
            }
        }

        stage('6. Trivy Image Scan') {
            agent {
                docker {
                    image 'ghcr.io/aquasecurity/trivy:0.49.1'
                    args "-v /var/run/docker.sock:/var/run/docker.sock -v ${TRIVY_CACHE_DIR}:/root/.cache/trivy -u 0:0 --network dacn-ci_ci --entrypoint=''"
                    reuseNode true
                }
            }
            steps {
                echo '--> Quét Docker image với Trivy...'
                // Thêm --clear-cache để xóa cache cũ tránh lỗi nhận diện sai version
                sh "trivy image --clear-cache"
                sh "trivy image --timeout 5m --ignore-unfixed --no-progress --severity ${TRIVY_SEVERITY} --exit-code ${TRIVY_EXIT_CODE} --ignorefile services/frontend/.trivyignore ${env.IMAGE_NAME}:${env.IMAGE_TAG}"
            }
        }
    }

    post {
        always {
            echo '--> Dọn dẹp docker images...'
            script {
                if (env.IMAGE_TAG) {
                    sh "docker rmi ${env.IMAGE_NAME}:${env.IMAGE_TAG} || true"
                }
                sh "docker image prune -f || true"
            }
        }
    }
}