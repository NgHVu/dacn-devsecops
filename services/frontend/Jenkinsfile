pipeline {
    agent none // Không chiếm dụng agent ở mức global để tiết kiệm tài nguyên

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
    }

    environment {
        APP_NAME        = 'frontend'
        // [FIX] Docker/GHCR yêu cầu tên repository phải viết THƯỜNG hoàn toàn
        REGISTRY        = 'ghcr.io/nghvu' 
        TRIVY_SEVERITY  = 'HIGH,CRITICAL'
        TRIVY_CACHE_DIR = "/var/jenkins_home/caches/trivy"
        NPM_CONFIG_CACHE = "/var/jenkins_home/caches/npm"
    }

    stages {
        stage('1. Prepare') {
            agent any
            steps {
                script {
                    echo '--> 1. Khởi tạo và làm sạch Workspace...'
                    // Xóa các file rác để đảm bảo code checkout là mới nhất
                    sh 'git clean -fdx'
                    checkout scm
                    
                    env.IMAGE_TAG = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    echo "--> IMAGE_TAG: ${env.IMAGE_TAG}"
                    
                    sh "mkdir -p ${TRIVY_CACHE_DIR} ${NPM_CONFIG_CACHE}"
                }
            }
        }

        stage('2. Quality & Security Gate (Parallel)') {
            parallel {
                stage('2.1. SonarQube Analysis') {
                    agent {
                        docker {
                            image 'node:20-bookworm-slim' // Debian slim giúp chạy Sonar cực ổn định
                            args "-v ${NPM_CONFIG_CACHE}:/root/.npm -u 0:0 --network dacn-ci_ci"
                        }
                    }
                    steps {
                        dir('services/frontend') {
                            script {
                                echo '--> Đang phân tích mã nguồn với SonarQube...'
                                sh 'apt-get update && apt-get install -y default-jre'
                                sh 'npm ci --prefer-offline --no-audit'
                                
                                withSonarQubeEnv('sonarqube-local') {
                                    sh """
                                        npx sonarqube-scanner \
                                        -Dsonar.projectKey=frontend-service \
                                        -Dsonar.sources=. \
                                        -Dsonar.exclusions=**/.next/**,**/node_modules/**,**/out/** \
                                        -Dsonar.host.url=${SONAR_HOST_URL} \
                                        -Dsonar.token=${SONAR_AUTH_TOKEN}
                                    """
                                }
                            }
                        }
                    }
                }

                stage('2.2. Trivy SCA Scan') {
                    agent any
                    steps {
                        dir('services/frontend') {
                            echo '--> Đang quét lỗ hổng thư viện (SCA)...'
                            sh "trivy fs --cache-dir ${TRIVY_CACHE_DIR} --ignore-unfixed --severity ${TRIVY_SEVERITY} --exit-code 1 ."
                        }
                    }
                }
            }
        }

        stage('3. Quality Gate Result') {
            agent any
            steps {
                echo '--> Kiểm tra kết quả Quality Gate...'
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('4. Build & Push Image') {
            agent any
            steps {
                script {
                    echo '--> Đang đóng gói Docker Image...'
                    withCredentials([string(credentialsId: 'github-pat', variable: 'GITHUB_TOKEN')]) {
                        sh "echo \$GITHUB_TOKEN | docker login ghcr.io -u nghvu --password-stdin"
                    }

                    // [FIX] Thêm --no-cache để ép Docker build lại layer deps, nhận diện package-lock.json mới
                    sh """
                        docker build --no-cache --pull \
                        -t ${env.REGISTRY}/${env.APP_NAME}:${env.IMAGE_TAG} \
                        -t ${env.REGISTRY}/${env.APP_NAME}:latest \
                        -f services/frontend/Dockerfile services/frontend
                    """
                    
                    echo '--> Đang đẩy Image lên GHCR...'
                    sh "docker push ${env.REGISTRY}/${env.APP_NAME}:${env.IMAGE_TAG}"
                    sh "docker push ${env.REGISTRY}/${env.APP_NAME}:latest"
                }
            }
        }

        stage('5. Final Security Scan') {
            agent {
                docker {
                    image 'ghcr.io/aquasecurity/trivy:0.49.1'
                    args "-v /var/run/docker.sock:/var/run/docker.sock -v ${TRIVY_CACHE_DIR}:/root/.cache/trivy -u 0:0 --entrypoint=''"
                }
            }
            steps {
                script {
                    // [FIX] Xóa cache Trivy để đảm bảo kết quả quét là mới nhất, không dùng database cũ
                    echo '--> Xóa cache Trivy cũ...'
                    sh "trivy image --clear-cache"

                    echo '--> Quét bảo mật Image cuối cùng trước khi hoàn tất...'
                    sh "trivy image --severity ${TRIVY_SEVERITY} --exit-code 1 ${env.REGISTRY}/${env.APP_NAME}:${env.IMAGE_TAG}"
                }
            }
        }
    }

    post {
        always {
            node('any') {
                script {
                    echo '--> Dọn dẹp hệ thống...'
                    try {
                        sh "docker rmi ${env.REGISTRY}/${env.APP_NAME}:${env.IMAGE_TAG} || true"
                        sh "docker image prune -f"
                    } catch (Exception e) {
                        echo "Lỗi khi dọn dẹp Docker: ${e.message}"
                    }
                    cleanWs()
                }
            }
        }
        success {
            echo '[SUCCESS] Pipeline hoàn thành xuất sắc!'
        }
        failure {
            echo '[FAILURE] Pipeline thất bại. Kiểm tra log ngay!'
        }
    }
}