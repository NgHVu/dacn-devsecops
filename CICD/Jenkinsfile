pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
    }

    environment {
        // --- THÔNG TIN CHUNG DỰ ÁN ---
        AWS_REGION      = 'ap-southeast-1'
        AWS_ACCOUNT_ID  = '257394468168'
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        
        // --- CẤU HÌNH BẢO MẬT & CACHE ---
        TRIVY_SEVERITY  = 'HIGH,CRITICAL'
        SCAN_CACHE_DIR  = "/var/lib/jenkins/.trivy-cache"
        
        // --- THÔNG TIN GITOPS (ArgoCD) ---
        GITOPS_REPO_URL = "github.com/NgHVu/dacn-config.git"
        GITOPS_CRED_ID  = "github-pat" 
        
        // --- SONARQUBE GLOBAL ---
        SONAR_AUTH_TOKEN = credentials('sonar-token')
        SONAR_HOST_URL   = 'http://localhost:9000'
    }

    stages {
        stage('1. Initialize & Detect Env') {
            steps {
                script {
                    sh 'chmod +x scripts/*.sh'
                    
                    // Tạo thư mục cache
                    sh "mkdir -p ${SCAN_CACHE_DIR}"
                    sh "mkdir -p /var/lib/jenkins/.m2/repository"
                    sh "mkdir -p /var/lib/jenkins/.npm"
                    
                    // --- [LOGIC MỚI] XÁC ĐỊNH MÔI TRƯỜNG DỰA TRÊN NHÁNH ---
                    if (env.BRANCH_NAME == 'develop') {
                        env.DEPLOY_ENV = 'dev'
                        echo "--> Detected Environment: DEV"
                    } 
                    else if (env.BRANCH_NAME == 'staging') {
                        env.DEPLOY_ENV = 'staging'
                        echo "--> Detected Environment: STAGING"
                    } 
                    else if (env.BRANCH_NAME == 'main') {
                        env.DEPLOY_ENV = 'prod'
                        echo "--> Detected Environment: PRODUCTION"
                    } 
                    else {
                        error "--> Branch ${env.BRANCH_NAME} is not configured for deployment. Skipping."
                    }

                    // Tạo Tag cho Docker Image
                    env.COMMIT_HASH = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    
                    // Prod dùng tag gọn, Dev/Staging dùng tag có tên nhánh để dễ debug
                    if (env.BRANCH_NAME == 'main') {
                        env.IMAGE_TAG = env.COMMIT_HASH
                    } else {
                        env.IMAGE_TAG = "${env.BRANCH_NAME}-${env.COMMIT_HASH}"
                    }
                    
                    echo "--> STARTING CI FOR BRANCH: ${env.BRANCH_NAME} | TARGET ENV: ${env.DEPLOY_ENV} | TAG: ${env.IMAGE_TAG}"
                }
                // Login ECR 1 lần dùng chung
                sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
            }
        }

        stage('2. Build & Deploy Microservices') {
            parallel {
                // ==========================================
                // 1. USERS SERVICE
                // ==========================================
                stage('Users Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/users/**"
                        }
                    }
                    environment { SERVICE_NAME = 'users' }
                    stages {
                        stage('Users: Code Analysis') {
                            agent {
                                docker {
                                    image 'maven:3.9-eclipse-temurin-21'
                                    args '--network host -v /var/lib/jenkins/.m2:/root/.m2 -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-backend.sh ${SERVICE_NAME}"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/target" } }
                        }
                        
                        stage('Users: Security & Build') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                                sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${ECR_REGISTRY}/foodhub-${SERVICE_NAME} ${env.IMAGE_TAG}"
                            }
                        }

                        stage('Users: Update GitOps') {
                            // Chạy trên cả 3 nhánh deploy
                            when { anyOf { branch 'main'; branch 'staging'; branch 'develop' } }
                            steps {
                                updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}")
                            }
                        }
                    }
                }

                // ==========================================
                // 2. PRODUCTS SERVICE
                // ==========================================
                stage('Products Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/products/**"
                        }
                    }
                    environment { SERVICE_NAME = 'products' }
                    stages {
                        stage('Products: Code Analysis') {
                            agent {
                                docker {
                                    image 'maven:3.9-eclipse-temurin-21'
                                    args '--network host -v /var/lib/jenkins/.m2:/root/.m2 -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-backend.sh ${SERVICE_NAME}"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/target" } }
                        }

                        stage('Products: Security & Build') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                                sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${ECR_REGISTRY}/foodhub-${SERVICE_NAME} ${env.IMAGE_TAG}"
                            }
                        }

                        stage('Products: Update GitOps') {
                            when { anyOf { branch 'main'; branch 'staging'; branch 'develop' } }
                            steps {
                                updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}")
                            }
                        }
                    }
                }

                // ==========================================
                // 3. ORDERS SERVICE
                // ==========================================
                stage('Orders Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/orders/**"
                        }
                    }
                    environment { SERVICE_NAME = 'orders' }
                    stages {
                        stage('Orders: Code Analysis') {
                            agent {
                                docker {
                                    image 'maven:3.9-eclipse-temurin-21'
                                    args '--network host -v /var/lib/jenkins/.m2:/root/.m2 -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-backend.sh ${SERVICE_NAME}"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/target" } }
                        }

                        stage('Orders: Security & Build') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                                sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${ECR_REGISTRY}/foodhub-${SERVICE_NAME} ${env.IMAGE_TAG}"
                            }
                        }

                        stage('Orders: Update GitOps') {
                            when { anyOf { branch 'main'; branch 'staging'; branch 'develop' } }
                            steps {
                                updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}")
                            }
                        }
                    }
                }

                // ==========================================
                // 4. FRONTEND SERVICE
                // ==========================================
                stage('Frontend Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/frontend/**"
                        }
                    }
                    environment { SERVICE_NAME = 'frontend' }
                    stages {
                        stage('Frontend: Code Analysis') {
                            agent {
                                docker {
                                    image 'node:20-bookworm'
                                    args '--network host -v /var/lib/jenkins/.npm:/root/.npm -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-frontend.sh"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/node_modules services/${SERVICE_NAME}/coverage" } }
                        }

                        stage('Frontend: Security & Build') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                                sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${ECR_REGISTRY}/foodhub-${SERVICE_NAME} ${env.IMAGE_TAG}"
                            }
                        }

                        stage('Frontend: Update GitOps') {
                            when { anyOf { branch 'main'; branch 'staging'; branch 'develop' } }
                            steps {
                                updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}")
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo '--> Cleaning up temporary docker images...'
            sh "docker image prune -f || true"
        }
        success {
            echo "Pipeline Success! Updated environment: ${env.DEPLOY_ENV}"
        }
        failure {
            echo "Pipeline Failed! Please check the logs."
        }
    }
}

// =========================================================
// HÀM HELPER: Cập nhật GitOps Repo ĐA MÔI TRƯỜNG
// =========================================================
def updateGitOps(serviceName, imageTag) {
    script {
        echo "--> [GitOps] Updating ${serviceName} in [${env.DEPLOY_ENV}] to tag: ${imageTag}"
        def tmpDir = "tmp-gitops-${serviceName}-${env.DEPLOY_ENV}"
        
        withCredentials([usernamePassword(credentialsId: "${GITOPS_CRED_ID}", passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
            sh """
                # MÔI TRƯỜNG CÔ LẬP
                mkdir -p ${tmpDir}_home
                export HOME=\$(pwd)/${tmpDir}_home
                
                rm -rf ${tmpDir}
                
                git config --global credential.helper store
                echo "https://\$GIT_USER:\$GIT_PASS@github.com" > ~/.git-credentials
                
                git clone https://${GITOPS_REPO_URL} ${tmpDir}
                
                # CHUYỂN VÀO THƯ MỤC MÔI TRƯỜNG TƯƠNG ỨNG 
                # Biến ${env.DEPLOY_ENV} sẽ là 'dev', 'staging', hoặc 'prod'
                cd ${tmpDir}/environments/${env.DEPLOY_ENV}/
                
                # Kiểm tra xem file có tồn tại không để tránh lỗi
                if [ ! -f ${serviceName}-values.yaml ]; then
                    echo "ERROR: File ${serviceName}-values.yaml does not exist in environments/${env.DEPLOY_ENV}/"
                    exit 1
                fi

                sed -i "s/tag: .*/tag: ${imageTag}/g" ${serviceName}-values.yaml
                
                if git diff --quiet; then
                    echo "No changes detected for ${serviceName} in ${env.DEPLOY_ENV}"
                else
                    git config user.email "jenkins-bot@foodhub.com"
                    git config user.name "FoodHub Jenkins Bot"
                    git add ${serviceName}-values.yaml
                    git commit -m "Update ${serviceName} image tag to ${imageTag} in ${env.DEPLOY_ENV} [skip ci]"
                    
                    count=0
                    until git push origin HEAD:main; do
                        echo "Push failed, retrying pull --rebase..."
                        git pull --rebase origin main
                        count=\$((count+1))
                        if [ \$count -ge 5 ]; then echo "Git push failed after 5 retries"; exit 1; fi
                        sleep 2
                    done
                fi
                
                cd ../../../
                rm -rf ${tmpDir} ${tmpDir}_home
            """
        }
    }
}